# Bot token from @BotFather
BOT_TOKEN=
# Telegram user ids allowed to use admin commands, comma separated
ADMIN_IDS=
# api_id / api_hash from https://my.telegram.org, used by the local Bot API server
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Empty BOT_API_URL: the bot talks to api.telegram.org, uploads are capped at 50 MB.
# For 2 GB uploads fill TELEGRAM_API_ID/HASH and run deploy/enable-local-api.sh, which sets
# COMPOSE_PROFILES=local-api and BOT_API_URL=http://bot-api:8081.
BOT_API_URL=
COMPOSE_PROFILES=
REDIS_URL=redis://localhost:6379/0
WORK_DIR=./work
DATA_DIR=./data

# Disk budget for downloads in progress, and the free space that must stay on the disk
WORK_DIR_LIMIT_MB=4096
MIN_FREE_DISK_MB=1024

# Concurrency: overall, per user, per site (others get DEFAULT_PLATFORM_LIMIT)
MAX_PARALLEL=3
MAX_PARALLEL_PER_USER=2
PLATFORM_LIMITS=tiktok=2,instagram=2,youtube=2
DEFAULT_PLATFORM_LIMIT=3
DOWNLOAD_TIMEOUT_S=900

# Optional proxies, rotated per request, for the sites listed in PROXY_PLATFORMS
PROXY_URLS=
PROXY_PLATFORMS=instagram,tiktok

# open: anyone can use the bot; list: only ids added with /allow
ACCESS_MODE=open
# Line under every caption, users can switch it off. Defaults to @<bot username>.
FOOTER_TEXT=

# yt-dlp / gallery-dl self-update: nightly or stable
AUTO_UPDATE=true
UPDATE_INTERVAL_H=12
UPDATE_CHANNEL=nightly

LOG_LEVEL=INFO
